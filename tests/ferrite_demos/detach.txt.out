use ferrite_session::{internal::protocol::Lock, prelude::*};

type Counter = LinearToShared<SendValue<u64, Release>>;

// couldnt synthesize function

fn shared_client() -> Session<ReceiveChannel<Counter, SendValue<u64, End>>> {
    receive_channel(|chan_0| {
        send_value(
            acquire_shared_session(chan_0, move |chan_4| {
                receive_value_from(chan_4, move |binder_1| {
                    release_shared_session(chan_4, binder_1)
                })
            }),
            terminate(),
        )
    })
}
