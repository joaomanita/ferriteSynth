use ferrite_session::{internal::protocol::Lock, prelude::*};

type Counter = LinearToShared<SendValue<u64, FixShared>>;

fn shared_provider_1(count: u64) -> Session<Counter> {
    shared_provider_1(count)
}
// fn shared_provider_1(count: u64) -> Session<Counter> { accept_shared_session(send_value(count, detach_shared_session(shared_provider_1(count)))) }

fn shared_client() -> Session<ReceiveChannel<Counter, SendValue<u64, End>>> {
    receive_channel(|chan_0| {
        cut! { [R]; shared_client(); binder_33 => {send_channel_to(binder_33, chan_0, receive_value_from(binder_33, move |binder_39| {wait(binder_33, send_value(binder_39, terminate ()))}))}}
    })
}
// fn shared_client() -> Session<ReceiveChannel<Counter, SendValue<u64, End>>> { receive_channel(|chan_0| {cut! { [R]; shared_client(); binder_33 => {send_channel_to(binder_33, chan_0, receive_value_from(binder_33, move |binder_39| {wait(binder_33, send_value(binder_39, terminate ()))}))}}}) }
