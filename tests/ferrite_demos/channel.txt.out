use std::{collections::VecDeque, future::Future, time::Duration};

use ferrite_session::prelude::*;
use tokio::time::sleep;

// Example implementation of Rust channels using shared channels

define_choice! {
    ActionsReceiver;
    Next: SendValue<Int, Z>,
    Close: End
}

define_choice! {
    ActionsChannel;
    ReceiveNext: ReceiveValue<Int, SharedToLinear<FixShared>>,
    SendNext: SendValue<int, SharedToLinear<FixShared>>
}

type Receiver = Rec<TyExternalChoiceId>;

type Channel = LinearToShared<TyExternalChoiceId>;

fn make_channel(val: Int) -> Session<LinearToShared<ActionsChannel>> {
    accept_shared_session(offer_case!(
        ReceiveNext,
        receive_value(|val_3| { detach_shared_session(make_channel(val_3)) })
    ))
}

fn make_receiver(chan: LinearToShared<ActionsChannel>, val: Int) -> Session<Rec<ActionsReceiver>> {
    fix_session(
        offer_choice! { Next: send_value(val, make_receiver(accept_shared_session(offer_case!(ReceiveNext, receive_value(|val_11| {detach_shared_session(make_channel(val_11))}))), val)), Close: terminate () },
    )
}
