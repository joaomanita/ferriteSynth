use std::{collections::VecDeque, future::Future, time::Duration};

use ferrite_session::prelude::*;
use tokio::time::sleep;

// Example implementation of Rust channels using shared channels

type Receiver = Rec<ExternalChoice<Next: SendValue<Int, Z>, Close: End>>;

type Channel = LinearToShared<
    ExternalChoice<
        ReceiveNext: ReceiveValue<Int, SharedToLinear<FixShared>>,
        SendNext: SendValue<Int, SharedToLinear<FixShared>>,
    >,
>;

fn make_channel(val: Int) -> Session<Channel> {
    accept_shared_session(
        offer_choice! { ReceiveNext: receive_value(|val_1| {detach_shared_session(make_channel(val_1))}), SendNext: send_value(val, detach_shared_session(make_channel(val))) },
    )
}

fn make_receiver(
    chan: LinearToShared<
        ExternalChoice<
            ReceiveNext: ReceiveValue<Int, SharedToLinear<FixShared>>,
            SendNext: SendValue<Int, SharedToLinear<FixShared>>,
        >,
    >,
    val: Int,
) -> Session<Receiver> {
    fix_session(
        offer_choice! { Next: send_value(val, make_receiver(accept_shared_session(offer_choice!{ ReceiveNext: receive_value(|val_5| {detach_shared_session(make_channel(val_5))}), SendNext: send_value(val, detach_shared_session(make_channel(val))) }), val)), Close: terminate () },
    )
}
