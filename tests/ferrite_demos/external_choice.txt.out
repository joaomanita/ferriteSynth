use ferrite_session::{either::*, prelude::*};

fn provider(
    arg1: String,
) -> Session<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>> {
    offer_choice! { Left: cut! { []; provider(arg1); binder_65 => {choose!(binder_65, Left, receive_value_from(binder_65, move |binder_73| {wait(binder_65, send_value(binder_73, terminate ()))}))}}, Right: receive_value(move |val_0| {cut! { []; provider(arg1); binder_105 => {choose!(binder_105, Left, receive_value_from(binder_105, move |binder_107| {wait(binder_105, terminate ())}))}}}) }
}
