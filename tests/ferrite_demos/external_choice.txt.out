use ferrite_session::{either::*, prelude::*};

fn creator() -> Session<SendValue<String, End>> {}

fn provider<A>() -> Session<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>>
{
    offer_choice! { Left => creator(), Right => receive_value(move |val_0| {cut::<HList![], _, _, _, _, _, _>(creator(), |binder_6| {receive_value_from(binder_6, move |binder_7| {wait(binder_6, terminate ())})})}) }
}
// fn provider<A>() -> Session<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>>  { offer_choice!{ Left => creator(), Right => receive_value(move |val_0| {terminate ()}) } }

fn client() -> Session<
    ReceiveChannel<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>, End>,
> {
    receive_channel(|chan_0| {
        choose!(
            chan_0,
            Left,
            receive_value_from(chan_0, move |binder_9| { wait(chan_0, terminate()) })
        )
    })
}

#[tokio::main]
pub async fn main() {
    run_session(cut::<HList![], _, _, _, _, _, _>(provider(), |binder_24| {
        cut::<HList![R], _, _, _, _, _, _>(client(), |binder_34| {
            send_channel_to(binder_34, binder_24, wait(binder_34, terminate()))
        })
    }))
    .await
}
