use ferrite_session::{either::*, prelude::*};

fn creator() -> Session<SendValue<String, End>> {}

fn provider<A>() -> Session<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>>
{
    offer_choice! { Left => send_value(cut::<HList![], _, _, _, _, _, _>(creator(), |binder_6| {receive_value_from(binder_6, move |binder_7| {wait(binder_6, binder_7)})}), terminate ()), Right => receive_value(move |val_0| {cut::<HList![], _, _, _, _, _, _>(creator(), |binder_10| {receive_value_from(binder_10, move |binder_11| {wait(binder_10, terminate ())})})}) }
}
// fn provider<A>() -> Session<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>>  { offer_choice!{ Left => send_value(cut::<HList![], _, _, _, _, _, _>(creator(), |binder_6| {receive_value_from(binder_6, move |binder_7| {wait(binder_6, binder_7)})}), terminate ()), Right => receive_value(move |val_0| {terminate ()}) } }

fn client() -> Session<
    ReceiveChannel<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>, End>,
> {
    receive_channel(|chan_0| {
        choose!(
            chan_0,
            Left,
            receive_value_from(chan_0, move |binder_13| { wait(chan_0, terminate()) })
        )
    })
}

#[tokio::main]
pub async fn main() {
    run_session(cut::<HList![], _, _, _, _, _, _>(provider(), |binder_47| {
        cut::<HList![R], _, _, _, _, _, _>(client(), |binder_62| {
            send_channel_to(binder_62, binder_47, wait(binder_62, terminate()))
        })
    }))
    .await
}
