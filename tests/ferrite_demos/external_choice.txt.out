use ferrite_session::{either::*, prelude::*};

fn creator() -> Session<SendChannel<A, End>> {}

fn provider() -> Session<ExternalChoice<Either<SendChannel<A, End>, ReceiveValue<u64, End>>>> {
    offer_choice! { Left: creator(), Right: receive_value(move |val_0| {terminate ()}) }
}

fn client() -> Session<
    ReceiveChannel<ExternalChoice<Either<SendValue<String, End>, ReceiveValue<u64, End>>>, End>,
> {
    receive_channel(|chan_0| {
        choose!(
            chan_0,
            Left,
            receive_value_from(chan_0, move |binder_5| { wait(chan_0, terminate()) })
        )
    })
}
