use ferrite_session::prelude::*;

define_choice! {
    FooBarBaz;
    Foo: SendValue<String, End>,
    Bar: ReceiveValue<u64, End>,
    Baz: End
}

fn provider(arg1: String) -> Session<TyExternalChoice<FooBarBaz>> {
    offer_choice! { Foo: send_value(arg1, terminate ()), Bar: receive_value(|val_0| {terminate ()}), Baz: terminate () }
}
// fn provider(arg1: String) -> Session<TyExternalChoice<FooBarBaz>> { offer_choice!{ Foo: send_value(arg1, terminate ()), Bar: receive_value(|val_0| {terminate ()}), Baz: terminate () } }

fn client() -> Session<ReceiveChannel<TyExternalChoice<FooBarBaz>, End>> {
    receive_channel(|chan_0| {
        cut! { [R]; client(); binder_20 => {send_channel_to(binder_20, chan_0, wait(binder_20, terminate ()))}}
    })
}
// fn client() -> Session<ReceiveChannel<TyExternalChoice<FooBarBaz>, End>> { receive_channel(|chan_0| {choose!(chan_0, Foo, receive_value_from(chan_0, move |binder_7| {wait(chan_0, terminate ())}))}) }
// fn client() -> Session<ReceiveChannel<TyExternalChoice<FooBarBaz>, End>> { receive_channel(|chan_0| {choose!(chan_0, Baz, wait(chan_0, terminate ()))}) }

fn main(arg1: String) {
    run_session(cut! { [L, R]; provider(arg1); binder_109 => {cut! { [R]; client(); binder_115 => {send_channel_to(binder_115, binder_109, wait(binder_115, terminate ()))}}}}).await()
}
