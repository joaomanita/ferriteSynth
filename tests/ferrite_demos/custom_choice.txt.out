use ferrite_session::prelude::*;

define_choice! {
    FooBarBaz;
    Foo: SendValue<String, End>,
    Bar: ReceiveValue<u64, End>,
    Baz: End
}

fn provider(arg1: String) -> Session<TyExternalChoice<FooBarBaz>> {
    offer_choice! { Foo: send_value(arg1, terminate ()), Bar: receive_value(|val_0| {terminate ()}), Baz: terminate () }
}

fn client() -> Session<ReceiveChannel<TyExternalChoice<FooBarBaz>, End>> {
    receive_channel(|chan_0| choose!(chan_0, Baz, wait(chan_0, terminate())))
}
// fn client() -> Session<ReceiveChannel<TyExternalChoice<FooBarBaz>, End>> { receive_channel(|chan_0| {choose!(chan_0, Foo, receive_value_from(chan_0, move |binder_1| {wait(chan_0, terminate ())}))}) }

fn main(arg1: String) {
    run_session(cut! { [R]; provider(arg1); binder_17 => {cut! { [R]; client(); binder_27 => {send_channel_to(binder_27, binder_17, wait(binder_27, terminate ()))}}}}).await()
}
