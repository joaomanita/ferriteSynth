use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, Z>,
    withdraw: SendValue<Int, ReceiveValue<Int, Z>>,
    Terminate: End
}

type RecBankOps = Rec<TyExternalChoiceId>;

// couldnt synthesize function

fn bank_session(
    withdraw_value: Int,
) -> Session<ReceiveValue<String, Rec<ExternalChoice<BankOps>>>> {
    receive_value(move |val_4| {
        fix_session(
            offer_choice! { deposit: receive_value(move |val_5| {bankops(val_5)}), withdraw: send_value(withdraw_value, receive_value(move |val_6| {bankops(val_6)})), Terminate: cut! { [L]; bankops(withdraw_value); binder_33 => {unfix_session(binder_33, choose!(binder_33, deposit, send_value_to(binder_33, withdraw_value, unfix_session(binder_33, choose!(binder_33, Terminate, wait(binder_33, terminate ()))))))}} },
        )
    })
}
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, Rec<ExternalChoice<BankOps>>>> { receive_value(move |val_4| {fix_session(offer_choice!{ deposit: receive_value(move |val_5| {bankops(val_5)}), withdraw: send_value(withdraw_value, receive_value(move |val_6| {bankops(val_6)})), Terminate: cut! { []; bankops(withdraw_value); binder_29 => {unfix_session(binder_29, choose!(binder_29, deposit, send_value_to(binder_29, withdraw_value, unfix_session(binder_29, choose!(binder_29, Terminate, wait(binder_29, terminate ()))))))}} })}) }
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, Rec<ExternalChoice<BankOps>>>> { receive_value(move |val_4| {bankops(withdraw_value)}) }

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, Rec<ExternalChoice<BankOps>>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            unfix_session(
                chan_0,
                choose!(
                    chan_0,
                    deposit,
                    send_value_to(
                        chan_0,
                        depositAmt,
                        unfix_session(
                            chan_0,
                            choose!(chan_0, Terminate, wait(chan_0, terminate()))
                        )
                    )
                ),
            ),
        )
    })
}
