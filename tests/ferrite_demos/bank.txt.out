use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, Z>,
    withdraw: SendValue<Int, ReceiveValue<Int, Z>>,
    Terminate: End
}

type RecBankOps = Rec<TyExternalChoiceId>;

fn bankops(arg1: Int) -> Session<Rec<TyExternalChoice<BankOps>>> {
    fix_session(
        offer_choice! { deposit: receive_value(|val_3| {bankops(val_3)}), withdraw: send_value(arg1, receive_value(|val_5| {bankops(val_5)})), Terminate: terminate () },
    )
}

fn bank_session(
    withdraw_value: Int,
) -> Session<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>> {
    receive_value(|val_6| {
        fix_session(
            offer_choice! { deposit: receive_value(|val_10| {bankops(val_10)}), withdraw: send_value(withdraw_value, receive_value(|val_12| {bankops(val_12)})), Terminate: cut! { []; bankops(withdraw_value); binder_3 => {unfix_session(binder_3, choose!(binder_3, Terminate, wait(binder_3, terminate ())))}} },
        )
    })
}
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>> { receive_value(|val_6| {fix_session(offer_choice!{ deposit: receive_value(|val_10| {bankops(val_10)}), withdraw: send_value(withdraw_value, receive_value(|val_12| {bankops(val_12)})), Terminate: cut! { []; bankops(withdraw_value); binder_3 => {unfix_session(binder_3, choose!(binder_3, withdraw, receive_value_from(binder_3, move |binder_4| {send_value_to(binder_3, withdraw_value, unfix_session(binder_3, choose!(binder_3, Terminate, wait(binder_3, terminate ()))))})))}} })}) }
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>> { receive_value(|val_6| {fix_session(offer_choice!{ deposit: receive_value(|val_10| {bankops(val_10)}), withdraw: send_value(withdraw_value, receive_value(|val_12| {bankops(val_12)})), Terminate: cut! { []; bankops(withdraw_value); binder_3 => {unfix_session(binder_3, choose!(binder_3, withdraw, receive_value_from(binder_3, move |binder_4| {send_value_to(binder_3, binder_4, unfix_session(binder_3, choose!(binder_3, Terminate, wait(binder_3, terminate ()))))})))}} })}) }
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>> { receive_value(|val_6| {fix_session(offer_choice!{ deposit: receive_value(|val_10| {bankops(val_10)}), withdraw: send_value(withdraw_value, receive_value(|val_12| {bankops(val_12)})), Terminate: cut! { []; bankops(withdraw_value); binder_3 => {unfix_session(binder_3, choose!(binder_3, deposit, send_value_to(binder_3, withdraw_value, unfix_session(binder_3, choose!(binder_3, Terminate, wait(binder_3, terminate ()))))))}} })}) }

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            unfix_session(
                chan_0,
                choose!(chan_0, Terminate, wait(chan_0, terminate())),
            ),
        )
    })
}
