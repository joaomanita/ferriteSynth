use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, Z>,
    withdraw: SendValue<Int, ReceiveValue<Int, Z>>,
    Terminate: End
}

type RecBankOps = Rec<TyExternalChoiceId>;

fn bankops(arg1: Int) -> Session<Rec<TyExternalChoice<BankOps>>> {
    fix_session(
        offer_choice! { deposit: receive_value(|val_0| {bankops(val_0)}), withdraw: send_value(arg1, receive_value(|val_2| {bankops(val_2)})), Terminate: terminate () },
    )
}

fn bank_session(
    withdraw_value: Int,
) -> Session<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>> {
    receive_value(|val_3| {
        fix_session(
            offer_choice! { deposit: receive_value(|val_4| {bankops(val_4)}), withdraw: send_value(withdraw_value, receive_value(|val_6| {bankops(val_6)})), Terminate: terminate () },
        )
    })
}

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, Rec<TyExternalChoice<BankOps>>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            unfix_session(
                chan_0,
                choose!(chan_0, Terminate, wait(chan_0, terminate())),
            ),
        )
    })
}
