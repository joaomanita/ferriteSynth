use std::format;

use ferrite_session::prelude::*;

type HelloSession = ReceiveValue<String, SendValue<String, End>>;

fn server() -> Session<HelloSession> {
    receive_value(move |val_0| send_value(val_0, terminate()))
}
// fn server() -> Session<HelloSession> { receive_value(move |val_0| {cut! { []; server(); binder_47 => {send_value_to(binder_47, val_0, receive_value_from(binder_47, move |binder_51| {wait(binder_47, send_value(binder_51, terminate ()))}))}}}) }
