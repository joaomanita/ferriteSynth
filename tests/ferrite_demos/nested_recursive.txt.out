use ferrite_session::{either::*, prelude::*};

define_choice! {
    StreamChoice;
    rec1: Rec<TyInternalChoice<Either<SendValue<String, Z>, S<Z>>>>,
    end1: ReceiveValue<String, End>
}

type Stream = Rec<TyExternalChoiceId>;

fn producer(arg1: String) -> Session<Rec<TyExternalChoice<StreamChoice>>> {
    producer(arg1)
}
