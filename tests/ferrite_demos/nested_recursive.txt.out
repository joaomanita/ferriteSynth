use ferrite_session::{either::*, prelude::*};

type Stream = Rec<
    ExternalChoice<
        Either<Rec<InternalChoice<Either<SendValue<String, Z>, S<Z>>>>, ReceiveValue<String, End>>,
    >,
>;

fn producer(arg1: String) -> Session<Stream> {
    producer(arg1)
}
