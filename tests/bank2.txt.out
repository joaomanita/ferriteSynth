use ferrite_session::prelude::*;

type BankOps = ExternalChoice<
    deposit: ReceiveValue<Int, End>,
    withdraw: SendValue<Int, ReceiveValue<Int, End>>,
    terminate: End,
>;

fn bankops(arg1: Int) -> Session<BankOps> {
    offer_choice! { deposit: receive_value(|val_0| {terminate ()}), withdraw: send_value(arg1, receive_value(|val_1| {terminate ()})), terminate: terminate () }
}

fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, BankOps>> {
    receive_value(|val_2| {
        offer_choice! { deposit: receive_value(|val_3| {terminate ()}), withdraw: send_value(withdraw_value, receive_value(|val_4| {terminate ()})), terminate: terminate () }
    })
}

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, BankOps>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            choose!(chan_0, terminate, wait(chan_0, terminate())),
        )
    })
}
