// fn myFunc() -> Session<ReceiveChannel<myType, SendValue<Int, SendValue<Int, End>>>> { receive_channel(|chan_0| {unfix_session(chan_0, choose!(chan_0, Left, receive_value_from(chan_0, move |binder_101| {unfix_session(chan_0, choose!(chan_0, Left, receive_value_from(chan_0, move |binder_177| {unfix_session(chan_0, choose!(chan_0, Left, receive_value_from(chan_0, move |binder_196| {cut! { [R]; myFunc(); binder_197 => {send_channel_to(binder_197, chan_0, receive_value_from(binder_197, move |binder_200| {receive_value_from(binder_197, move |binder_201| {wait(binder_197, send_value(binder_201, send_value(binder_201, terminate ())))})}))}}})))})))})))}) }
