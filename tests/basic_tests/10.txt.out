use std::format;

use ferrite_session::prelude::*;

type myType = Rec<TyExternalChoice<Either<SendValue<Int, Z>, End>>>;

fn myFunc() -> Session<ReceiveChannel<myType, SendValue<Int, SendValue<Int, End>>>> {
    receive_channel(|chan_0| {
        unfix_session(
            chan_0,
            choose!(
                chan_0,
                Left,
                receive_value_from(chan_0, move |binder_101| {
                    unfix_session(
                        chan_0,
                        choose!(
                            chan_0,
                            Right,
                            wait(
                                chan_0,
                                send_value(binder_101, send_value(binder_101, terminate()))
                            )
                        ),
                    )
                })
            ),
        )
    })
}
