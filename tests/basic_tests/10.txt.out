use std::format;

use ferrite_session::prelude::*;

type myType = Rec<TyExternalChoice<Either<SendValue<Int, Z>, End>>>;

fn myFunc() -> Session<ReceiveChannel<myType, SendValue<Int, SendValue<Int, End>>>> {
    receive_channel(|chan_0| {
        cut! { [R]; myFunc(); binder_925 => {send_channel_to(binder_925, chan_0, receive_value_from(binder_925, move |binder_975| {receive_value_from(binder_925, move |binder_976| {wait(binder_925, send_value(binder_976, send_value(binder_976, terminate ())))})}))}}
    })
}
