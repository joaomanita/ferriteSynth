use std::format;

use ferrite_session::prelude::*;

type myType = Rec<TyExternalChoice<Either<SendValue<Int, Z>, End>>>;

fn myFunc() -> Session<ReceiveChannel<myType, SendValue<Int, SendValue<Int, End>>>> {
    receive_channel(|chan_0| {
        cut! { [R]; myFunc(); binder_4029 => {send_channel_to(binder_4029, chan_0, receive_value_from(binder_4029, move |binder_4235| {receive_value_from(binder_4029, move |binder_4236| {wait(binder_4029, send_value(binder_4236, send_value(binder_4236, terminate ())))})}))}}
    })
}
