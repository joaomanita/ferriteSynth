use std::format;

use ferrite_session::prelude::*;

fn myFunc() -> Session<Rec<ExternalChoice<Either<ReceiveValue<Int, End>, Z>>>> {
    fix_session(
        offer_choice! { Left => receive_value(move |val_0| {cut::<HList![], _, _, _, _, _, _>(myFunc(), |binder_3| {unfix_session(binder_3, choose!(binder_3, Left, send_value_to(binder_3, val_0, wait(binder_3, terminate ()))))})}), Right => myFunc() },
    )
}
