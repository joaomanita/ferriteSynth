use ferrite_session::{either::*, prelude::*};
type myType1<A> = ReceiveChannel<ExternalChoice<Either<A, A>>, A>;

fn myFunc2<A>() -> Session<myType1<A>>
where
    A: Protocol,
{
    receive_channel(|chan_0| choose!(chan_0, Right, forward(chan_0)))
}
// fn myFunc2<A>() -> Session<myType1<A>> where A: Protocol { receive_channel(|chan_0| {choose!(chan_0, Left, forward(chan_0))}) }
