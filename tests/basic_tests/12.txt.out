fn sender() -> Session<
    ReceiveChannel<
        A,
        ReceiveChannel<A, ReceiveChannel<ReceiveChannel<A, ReceiveChannel<A, End>>, End>>,
    >,
> {
    receive_channel(|chan_0| {
        receive_channel(|chan_1| {
            receive_channel(|chan_2| {
                cut! { [R, R, R]; sender(); binder_7 => {send_channel_to(binder_7, chan_0, send_channel_to(binder_7, chan_1, send_channel_to(binder_7, chan_2, wait(binder_7, terminate ()))))}}
            })
        })
    })
}
