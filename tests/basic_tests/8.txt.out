// fn myFunc2() -> Session<ReceiveChannel<myType, ReceiveChannel<A, SendChannel<B, End>>>> { receive_channel(|chan_0| {receive_channel(|chan_1| {send_channel_to(chan_0, chan_1, cut! { [L]; myFunc(receive_channel(|chan_5| {forward(chan_0)}), forward(chan_5)); binder_3 => {send_channel_from(binder_3, terminate ())}})})}) }
