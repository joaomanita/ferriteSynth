use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, End>,
    withdraw: SendValue<Int, ReceiveValue<Int, End>>,
    Terminate: End
}

fn bankops(arg1: Int) -> Session<TyExternalChoice<BankOps>> {
    offer_choice! { deposit: receive_value(|val_0| {terminate ()}), withdraw: send_value(arg1, receive_value(|val_12| {terminate ()})), Terminate: terminate () }
}

fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, TyExternalChoice<BankOps>>> {
    receive_value(|val_13| {
        offer_choice! { deposit: receive_value(|val_14| {terminate ()}), withdraw: send_value(withdraw_value, receive_value(|val_46| {terminate ()})), Terminate: terminate () }
    })
}

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, TyExternalChoice<BankOps>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            choose!(
                chan_0,
                deposit,
                send_value_to(chan_0, depositAmt, wait(chan_0, terminate()))
            ),
        )
    })
}
// fn client_session(myId: String, depositAmt: Int) -> Session<ReceiveChannel<ReceiveValue<String, TyExternalChoice<BankOps>>, End>> { receive_channel(|chan_0| {send_value_to(chan_0, myId, choose!(chan_0, withdraw, receive_value_from(chan_0, move |binder_13| {send_value_to(chan_0, binder_13, wait(chan_0, terminate ()))})))}) }
