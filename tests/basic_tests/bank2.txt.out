use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, End>,
    withdraw: SendValue<Int, ReceiveValue<Int, End>>,
    Terminate: End
}

fn bankops(arg1: Int) -> Session<ExternalChoice<BankOps>> {
    offer_choice! { deposit: receive_value(move |val_0| {terminate ()}), withdraw: send_value(arg1, receive_value(move |val_3| {terminate ()})), Terminate: terminate () }
}
// fn bankops(arg1: Int) -> Session<ExternalChoice<BankOps>> { offer_choice!{ deposit: receive_value(move |val_0| {terminate ()}), withdraw: send_value(arg1, receive_value(move |val_1| {terminate ()})), Terminate: terminate () } }

fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, ExternalChoice<BankOps>>> {
    receive_value(move |val_4| {
        offer_choice! { deposit: receive_value(move |val_5| {terminate ()}), withdraw: send_value(withdraw_value, receive_value(move |val_8| {terminate ()})), Terminate: terminate () }
    })
}
// fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, ExternalChoice<BankOps>>> { receive_value(move |val_4| {offer_choice!{ deposit: receive_value(move |val_5| {terminate ()}), withdraw: send_value(withdraw_value, receive_value(move |val_6| {terminate ()})), Terminate: terminate () }}) }

fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, ExternalChoice<BankOps>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            choose!(
                chan_0,
                deposit,
                send_value_to(chan_0, depositAmt, wait(chan_0, terminate()))
            ),
        )
    })
}
// fn client_session(myId: String, depositAmt: Int) -> Session<ReceiveChannel<ReceiveValue<String, ExternalChoice<BankOps>>, End>> { receive_channel(|chan_0| {send_value_to(chan_0, myId, choose!(chan_0, deposit, send_value_to(chan_0, depositAmt, wait(chan_0, terminate ()))))}) }
