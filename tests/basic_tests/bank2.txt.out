fn client_session(
    myId: String,
    depositAmt: Int,
) -> Session<ReceiveChannel<ReceiveValue<String, ExternalChoice<BankOps>>, End>> {
    receive_channel(|chan_0| {
        send_value_to(
            chan_0,
            myId,
            choose!(chan_0, Terminate, wait(chan_0, terminate())),
        )
    })
}
