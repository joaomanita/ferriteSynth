use ferrite_session::prelude::*;

define_choice! {
    BankOps;
    deposit: ReceiveValue<Int, End>,
    withdraw: SendValue<Int, ReceiveValue<Int, End>>,
    Terminate: End
}

fn bankops(arg1: Int) -> Session<TyExternalChoice<BankOps>> {
    offer_choice! { deposit: receive_value(|val_0| {terminate ()}), withdraw: send_value(arg1, receive_value(|val_2| {terminate ()})), Terminate: terminate () }
}

fn bank_session(withdraw_value: Int) -> Session<ReceiveValue<String, TyExternalChoice<BankOps>>> {
    receive_value(|val_3| {
        offer_choice! { deposit: receive_value(|val_4| {cut! { []; bankops(val_4); binder_4 => {choose!(binder_4, Terminate, wait(binder_4, terminate ()))}}}), withdraw: send_value(withdraw_value, receive_value(|val_11| {cut! { []; bankops(val_11); binder_82 => {choose!(binder_82, Terminate, wait(binder_82, terminate ()))}}})), Terminate: cut! { []; bankops(withdraw_value); binder_94 => {choose!(binder_94, Terminate, wait(binder_94, terminate ()))}} }
    })
}
