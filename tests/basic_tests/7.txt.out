use std::format;

use ferrite_session::prelude::*;

type myType = Session<ReceiveChannel<A, B>>;

fn myFunc(arg1: Session<ReceiveChannel<A, B>>, arg2: A) -> Session<B> {
    myFunc(
        receive_channel(|chan_19| {
            cut! { [L, R]; arg1; binder_31 => {send_channel_to(binder_31, chan_19, forward(binder_31))}}
        }),
        forward(arg2),
    )
}
