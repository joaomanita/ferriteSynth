use std::format;

use ferrite_session::prelude::*;

type myType = Session<ReceiveChannel<A, B>>;

fn myFunc(arg1: Session<ReceiveChannel<A, B>>, arg2: A) -> Session<B> {
    myFunc(
        receive_channel(|chan_71| {
            cut! { [L, R]; arg1; binder_103 => {send_channel_to(binder_103, chan_71, forward(binder_103))}}
        }),
        forward(arg2),
    )
}
