type myType = ReceiveChannel<
    LinearToShared<ReceiveChannel<A, B>>,
    ReceiveChannel<LinearToShared<A>, LinearToShared<B>>,
>;

fn myFunc2() -> Session<myType> {
    receive_channel(|chan_0| {
        receive_channel(|chan_1| {
            accept_shared_session(acquire_shared_session(chan_1, move |chan_6| {
                acquire_shared_session(chan_0, move |chan_7| {
                    send_channel_to(chan_7, chan_6, forward(chan_7))
                })
            }))
        })
    })
}
