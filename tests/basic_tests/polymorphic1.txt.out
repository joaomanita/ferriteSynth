use std::format;

use ferrite_session::prelude::*;

fn chooser<A, B>(
    arg1: A,
    arg2: B,
) -> Session<Rec<TyInternalChoice<Either<SendValue<A, Z>, SendValue<B, Z>>>>> {
    fix_session(offer_case!(
        Left,
        send_value(arg1, chooser(forward(arg1), forward(arg2)))
    ))
}

fn repeater() -> Session<
    ReceiveValue<
        Int,
        ReceiveValue<
            String,
            Rec<TyInternalChoice<Either<SendValue<Int, Z>, SendValue<String, Z>>>>,
        >,
    >,
> {
    receive_value(|val_0| {
        receive_value(|val_1| {
            fix_session(offer_case!(Right, send_value(val_1, chooser(val_0, val_1))))
        })
    })
}
