use std::format;

use ferrite_session::prelude::*;

fn chooser<A, B>(
    arg1: A,
    arg2: B,
) -> Session<Rec<InternalChoice<Either<SendValue<A, Z>, SendValue<B, Z>>>>> {
    fix_session(offer_case!(
        Left,
        send_value(forward(arg1), chooser(arg1, forward(arg2)))
    ))
}
// fn chooser<A, B>(arg1: A, arg2: B) -> Session<Rec<InternalChoice<Either<SendValue<A, Z>, SendValue<B, Z>>>>>  { fix_session(offer_case!(Left, send_value(forward(arg1), chooser(forward(arg1), forward(arg2))))) }

fn repeater() -> Session<
    ReceiveValue<
        Int,
        ReceiveValue<String, Rec<InternalChoice<Either<SendValue<Int, Z>, SendValue<String, Z>>>>>,
    >,
> {
    receive_value(move |val_0| {
        receive_value(move |val_1| {
            fix_session(offer_case!(Left, send_value(val_0, chooser(val_0, val_1))))
        })
    })
}
// fn repeater() -> Session<ReceiveValue<Int, ReceiveValue<String, Rec<InternalChoice<Either<SendValue<Int, Z>, SendValue<String, Z>>>>>>>  { receive_value(move |val_0| {receive_value(move |val_1| {fix_session(offer_case!(Left, send_value(val_0, chooser(val_0, val_1))))})}) }
