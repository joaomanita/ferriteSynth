use std::format;

use ferrite_session::prelude::*;

type myType = Session<ReceiveChannel<A, B>>;

fn myFunc(arg1: myType, arg2: A) -> Session<B> {
    cut::<HList![]>(arg1, |binder_0| {
        send_channel_to(binder_0, arg2, forward(binder_0))
    })
}

fn myFunc2() -> Session<SendChannel<B, End>> {
    cut::<HList![]>(myFunc, |binder_1| send_channel_from(binder_1, terminate()))
}
