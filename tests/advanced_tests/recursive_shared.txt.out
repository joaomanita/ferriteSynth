use std::format;

use ferrite_session::prelude::*;

type SharedService = LinearToShared<
    TyExternalChoice<Either<SendValue<String, FixShared>, ReceiveValue<String, FixShared>>>,
>;

fn shared_provider(arg1: String) -> Session<SharedService> {
    shared_provider(arg1)
}
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(|val_0| {detach_shared_session(shared_provider(val_0))}) }) }

fn rec_provider(
    arg1: String,
) -> Session<Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> {
    cut! { []; shared_provider(arg1); binder_16307 => {acquire_shared_session(binder_16307, move |chan_22399| {choose!(chan_22399, Left, receive_value_from(chan_22399, move |binder_28535| {rec_provider(binder_28535)}))})}}
}
// fn rec_provider(arg1: String) -> Session<Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { []; shared_provider(arg1); binder_16307 => {acquire_shared_session(binder_16307, move |chan_22399| {choose!(chan_22399, Right, send_value_to(chan_22399, arg1, release_shared_session(chan_22399, fix_session(offer_choice!{ Left: send_channel_from(chan_26947, rec_provider(arg1)), Right: cut! { []; rec_provider(arg1); binder_31537 => {unfix_session(binder_31537, choose!(binder_31537, Left, receive_channel_from(binder_31537, |binder_31575| {acquire_shared_session(binder_31575, move |chan_26987| {choose!(chan_26987, Left, receive_value_from(chan_26987, move |binder_31595| {unfix_session(binder_31537, wait(binder_31537, terminate ()))}))})})))}} }))))})}} }

fn user() -> Session<
    ReceiveChannel<
        Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>,
        SendValue<String, SendValue<String, End>>,
    >,
> {
    receive_channel(|chan_27908| {
        cut! { [R]; user(); binder_273233 => {send_channel_to(binder_273233, chan_27908, receive_value_from(binder_273233, move |binder_287215| {receive_value_from(binder_273233, move |binder_287216| {wait(binder_273233, send_value(binder_287216, send_value(binder_287216, terminate ())))})}))}}
    })
}
