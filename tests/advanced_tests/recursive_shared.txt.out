use std::format;

use ferrite_session::prelude::*;

type SharedService = LinearToShared<
    ExternalChoice<Either<SendValue<String, Release>, ReceiveValue<String, Release>>>,
>;

fn shared_provider(arg1: String) -> Session<SharedService> {
    shared_provider(arg1)
}
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(move |val_0| {detach_shared_session(shared_provider(val_0))}) }) }
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(move |val_0| {detach_shared_session(shared_provider(val_0))}) }) }

fn rec_provider(
    arg1: String,
) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> {
    cut! { [L]; shared_provider(arg1); binder_84673 => {acquire_shared_session(binder_84673, move |chan_510011| {choose!(chan_510011, Left, receive_value_from(chan_510011, move |binder_99137| {release_shared_session(chan_510011, fix_session(offer_choice!{ Left: send_channel_from(chan_539351, rec_provider(binder_99137)), Right: terminate () }))}))})}}
}
// fn rec_provider(arg1: String) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { [L]; shared_provider(arg1); binder_84673 => {acquire_shared_session(binder_84673, move |chan_510011| {choose!(chan_510011, Left, receive_value_from(chan_510011, move |binder_99137| {release_shared_session(chan_510011, fix_session(offer_choice!{ Left: send_channel_from(chan_539351, rec_provider(binder_99137)), Right: terminate () }))}))})}} }
// fn rec_provider(arg1: String) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { []; shared_provider(arg1); binder_17113 => {acquire_shared_session(binder_17113, move |chan_146779| {choose!(chan_146779, Left, receive_value_from(chan_146779, move |binder_31577| {release_shared_session(chan_146779, fix_session(offer_choice!{ Left: send_channel_from(chan_176119, rec_provider(binder_31577)), Right: terminate () }))}))})}} }
// fn rec_provider(arg1: String) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { []; shared_provider(arg1); binder_17113 => {acquire_shared_session(binder_17113, move |chan_146779| {choose!(chan_146779, Left, receive_value_from(chan_146779, move |binder_31577| {release_shared_session(chan_146779, fix_session(offer_choice!{ Left: send_channel_from(chan_176119, rec_provider(binder_31577)), Right: terminate () }))}))})}} }

fn user() -> Session<
    ReceiveChannel<
        Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>,
        SendValue<String, SendValue<String, End>>,
    >,
> {
    receive_channel(|chan_545256| {
        cut! { [R]; user(); binder_163343 => {send_channel_to(binder_163343, chan_545256, receive_value_from(binder_163343, move |binder_168464| {receive_value_from(binder_163343, move |binder_168465| {wait(binder_163343, send_value(binder_168465, send_value(binder_168465, terminate ())))})}))}}
    })
}
// fn user() -> Session<ReceiveChannel<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>, SendValue<String, SendValue<String, End>>>> { receive_channel(|chan_545256| {cut! { [R]; user(); binder_163343 => {send_channel_to(binder_163343, chan_545256, receive_value_from(binder_163343, move |binder_168464| {receive_value_from(binder_163343, move |binder_168465| {wait(binder_163343, send_value(binder_168465, send_value(binder_168465, terminate ())))})}))}}}) }
// fn user() -> Session<ReceiveChannel<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>, SendValue<String, SendValue<String, End>>>> { receive_channel(|chan_545256| {unfix_session(chan_545256, choose!(chan_545256, Left, receive_channel_from(chan_545256, |binder_124913| {acquire_shared_session(binder_124913, move |chan_589128| {choose!(chan_589128, Left, receive_value_from(chan_589128, move |binder_126489| {release_shared_session(chan_589128, unfix_session(chan_545256, wait(chan_545256, send_value(binder_126489, send_value(binder_126489, terminate ())))))}))})})))}) }
