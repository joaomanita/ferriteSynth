use std::format;

use ferrite_session::prelude::*;

type SharedService = LinearToShared<
    ExternalChoice<Either<SendValue<String, Release>, ReceiveValue<String, Release>>>,
>;

fn shared_provider(arg1: String) -> Session<SharedService> {
    shared_provider(arg1)
}
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(move |val_0| {detach_shared_session(shared_provider(val_0))}) }) }
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(move |val_0| {detach_shared_session(shared_provider(val_0))}) }) }

fn rec_provider(
    arg1: String,
) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> {
    cut! { [L]; shared_provider(arg1); binder_84381 => {acquire_shared_session(binder_84381, move |chan_354621| {choose!(chan_354621, Left, receive_value_from(chan_354621, move |binder_93129| {release_shared_session(chan_354621, fix_session(offer_choice!{ Left: send_channel_from(chan_367233, rec_provider(binder_93129)), Right: terminate () }))}))})}}
}
// fn rec_provider(arg1: String) -> Session<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { []; shared_provider(arg1); binder_26733 => {acquire_shared_session(binder_26733, move |chan_174029| {choose!(chan_174029, Left, receive_value_from(chan_174029, move |binder_46285| {release_shared_session(chan_174029, fix_session(offer_choice!{ Left: send_channel_from(chan_192657, rec_provider(binder_46285)), Right: terminate () }))}))})}} }

fn user() -> Session<
    ReceiveChannel<
        Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>,
        SendValue<String, SendValue<String, End>>,
    >,
> {
    receive_channel(|chan_369626| {
        cut! { [R]; user(); binder_100653 => {send_channel_to(binder_100653, chan_369626, receive_value_from(binder_100653, move |binder_100660| {receive_value_from(binder_100653, move |binder_100661| {wait(binder_100653, send_value(binder_100661, send_value(binder_100661, terminate ())))})}))}}
    })
}
// fn user() -> Session<ReceiveChannel<Rec<ExternalChoice<Either<SendChannel<SharedService, Z>, End>>>, SendValue<String, SendValue<String, End>>>> { receive_channel(|chan_369626| {unfix_session(chan_369626, choose!(chan_369626, Left, receive_channel_from(chan_369626, |binder_97829| {acquire_shared_session(binder_97829, move |chan_384438| {choose!(chan_384438, Left, receive_value_from(chan_384438, move |binder_98685| {release_shared_session(chan_384438, unfix_session(chan_369626, wait(chan_369626, send_value(binder_98685, send_value(binder_98685, terminate ())))))}))})})))}) }
