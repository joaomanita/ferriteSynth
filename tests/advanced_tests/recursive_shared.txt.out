use std::format;

use ferrite_session::prelude::*;

type SharedService = LinearToShared<
    TyExternalChoice<Either<SendValue<String, FixShared>, ReceiveValue<String, FixShared>>>,
>;

fn shared_provider(arg1: String) -> Session<SharedService> {
    shared_provider(arg1)
}
// fn shared_provider(arg1: String) -> Session<SharedService> { accept_shared_session(offer_choice!{ Left: send_value(arg1, detach_shared_session(shared_provider(arg1))), Right: receive_value(|val_0| {detach_shared_session(shared_provider(val_0))}) }) }

fn rec_provider(
    arg1: String,
) -> Session<Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> {
    cut! { []; shared_provider(arg1); binder_18725 => {acquire_shared_session(binder_18725, move |chan_138013| {choose!(chan_138013, Left, receive_value_from(chan_138013, move |binder_34645| {release_shared_session(chan_138013, fix_session(offer_choice!{ Left: send_channel_from(chan_164561, rec_provider(binder_34645)), Right: cut! { []; rec_provider(binder_34645); binder_35795 => {unfix_session(binder_35795, choose!(binder_35795, Left, receive_channel_from(binder_35795, |binder_35809| {acquire_shared_session(binder_35809, move |chan_165597| {choose!(chan_165597, Left, receive_value_from(chan_165597, move |binder_35817| {release_shared_session(chan_165597, unfix_session(binder_35795, wait(binder_35795, terminate ())))}))})})))}} }))}))})}}
}
// fn rec_provider(arg1: String) -> Session<Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>> { cut! { []; shared_provider(arg1); binder_18725 => {acquire_shared_session(binder_18725, move |chan_138013| {choose!(chan_138013, Left, receive_value_from(chan_138013, move |binder_34645| {release_shared_session(chan_138013, fix_session(offer_choice!{ Left: send_channel_from(chan_164561, rec_provider(binder_34645)), Right: terminate () }))}))})}} }

fn user() -> Session<
    ReceiveChannel<
        Rec<TyExternalChoice<Either<SendChannel<SharedService, Z>, End>>>,
        SendValue<String, SendValue<String, End>>,
    >,
> {
    receive_channel(|chan_170718| {
        cut! { [R]; user(); binder_112521 => {send_channel_to(binder_112521, chan_170718, receive_value_from(binder_112521, move |binder_118922| {receive_value_from(binder_112521, move |binder_118923| {wait(binder_112521, send_value(binder_118923, send_value(binder_118923, terminate ())))})}))}}
    })
}
