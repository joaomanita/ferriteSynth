use std::format;

use ferrite_session::prelude::*;

fn combiner<A, B>(arg1: A, arg2: B) -> Session<ExternalChoice<Either<A, B>>> {
    offer_choice! { Left: forward(arg1), Right: forward(arg2) }
}

fn chooser() -> Session<ReceiveValue<String, ReceiveValue<Int, SendValue<Int, End>>>> {
    receive_value(move |val_0| {
        receive_value(move |val_1| {
            cut! { [L]; combiner(val_1, val_0); binder_4645 => {choose!(binder_4645, Left, receive_value_from(binder_4645, move |binder_5129| {wait(binder_4645, send_value(binder_5129, cut! { []; chooser(); binder_5151 => {send_value_to(binder_5151, val_0, send_value_to(binder_5151, binder_5129, receive_value_from(binder_5151, move |binder_5153| {wait(binder_5151, terminate ())})))}}))}))}}
        })
    })
}
