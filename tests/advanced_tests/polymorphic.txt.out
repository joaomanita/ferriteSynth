use std::format;

use ferrite_session::prelude::*;

fn combiner<A, B>(arg1: A, arg2: B) -> Session<TyExternalChoice<Either<A, B>>> {
    offer_choice! { Left: forward(arg1), Right: forward(arg2) }
}

fn chooser() -> Session<ReceiveValue<String, ReceiveValue<Int, SendValue<Int, End>>>> {
    receive_value(|val_0| {
        receive_value(|val_1| {
            cut! { []; combiner(val_0, val_0); binder_25 => {choose!(binder_25, Left, receive_value_from(binder_25, move |binder_29| {wait(binder_25, send_value(binder_29, terminate ()))}))}}
        })
    })
}
