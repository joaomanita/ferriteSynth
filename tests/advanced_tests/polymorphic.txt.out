use std::format;

use ferrite_session::prelude::*;

fn combiner<A, B>(arg1: A, arg2: B) -> Session<TyExternalChoice<Either<A, B>>> {
    offer_choice! { Left: forward(arg1), Right: forward(arg2) }
}

fn chooser() -> Session<ReceiveValue<String, ReceiveValue<Int, SendValue<Int, End>>>> {
    receive_value(|val_0| {
        receive_value(|val_1| {
            cut! { [R]; chooser(); binder_589 => {cut! { [L]; combiner(binder_589, val_0); binder_617 => {choose!(binder_617, Left, receive_value_from(binder_617, move |binder_621| {wait(binder_617, send_value(binder_621, terminate ()))}))}}}}
        })
    })
}
